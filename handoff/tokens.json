{
  "$schema": "https://schemas.opsgrid.dev/tokens.json",
  "name": "OpsGrid Design Tokens",
  "version": "0.1.0-wireframe",

  "font": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },

  "fontSize": {
    "11": ["11px", "16px"], "12": ["12px", "18px"],
    "13": ["13px", "20px"], "14": ["14px", "22px"],
    "15": ["15px", "24px"], "18": ["18px", "26px"],
    "22": ["22px", "30px"], "28": ["28px", "36px"],
    "36": ["36px", "44px"], "48": ["48px", "56px"]
  },

  "space": { "0":0, "1":4, "2":8, "3":12, "4":16, "5":20, "6":24, "8":32, "10":40, "12":48, "16":64, "20":80 },

  "radius": { "1":4, "2":8, "3":12, "4":16, "5":24, "pill": 999 },

  "shadow": {
    "1": "0 1px 2px rgba(15, 18, 30, 0.04), 0 1px 1px rgba(15, 18, 30, 0.03)",
    "2": "0 2px 6px rgba(15, 18, 30, 0.06), 0 1px 2px rgba(15, 18, 30, 0.04)",
    "3": "0 8px 24px rgba(15, 18, 30, 0.10), 0 2px 4px rgba(15, 18, 30, 0.05)",
    "4": "0 20px 48px rgba(15, 18, 30, 0.14), 0 4px 8px rgba(15, 18, 30, 0.06)"
  },

  "transition": {
    "fast": "120ms cubic-bezier(0.2, 0, 0, 1)",
    "base": "150ms cubic-bezier(0.2, 0, 0, 1)",
    "slow": "240ms cubic-bezier(0.2, 0, 0, 1)"
  },

  "neutralsLight": {
    "0":"#ffffff", "50":"#f7f8fa", "100":"#eef0f4", "200":"#dde0e6",
    "300":"#c4c8d1", "400":"#9ea3b0", "500":"#6b7180", "600":"#4a4f5d",
    "700":"#2f333e", "800":"#1a1d27", "900":"#0e111a"
  },

  "neutralsDark": {
    "0":"#0e111a", "50":"#14171f", "100":"#1b1f29", "200":"#262b38",
    "300":"#3a4051", "400":"#5a6172", "500":"#8a91a3", "600":"#b5bbc9",
    "700":"#d4d8e2", "800":"#e8eaf0", "900":"#f4f5f9"
  },

  "semanticLight": {
    "bg": "{neutralsLight.50}", "surface": "{neutralsLight.0}",
    "surfaceAlt": "{neutralsLight.100}", "border": "{neutralsLight.200}",
    "borderSoft": "{neutralsLight.100}", "borderStrong": "{neutralsLight.300}",
    "text": "{neutralsLight.900}", "textSoft": "{neutralsLight.600}", "textMute": "{neutralsLight.500}"
  },

  "status": {
    "success": "#0fb583",
    "warning": "#f4a300",
    "danger":  "#e8455a"
  },

  "palettes": {
    "electric": { "label": "Electric",   "primary": "#4f3cff", "relation": "#ff3b8a", "compute": "#a8ff2a", "computeInk": "#0e0a2a" },
    "citrus":   { "label": "Citrus pop", "primary": "#1e4cff", "relation": "#ff6a18", "compute": "#e436b6", "computeInk": "#ffffff" },
    "mint":     { "label": "Mint punch", "primary": "#0fb583", "relation": "#ff5a6c", "compute": "#8b3df0", "computeInk": "#ffffff" },
    "dusk":     { "label": "Neon dusk",  "primary": "#a020e0", "relation": "#ff2d8b", "compute": "#00d8d8", "computeInk": "#0a1818" },
    "tropic":   { "label": "Tropical",   "primary": "#00a8a8", "relation": "#ff7a1a", "compute": "#f4c000", "computeInk": "#1a1408" },
    "y2k":      { "label": "Y2K",        "primary": "#ff2eb3", "relation": "#00c4ff", "compute": "#caff00", "computeInk": "#1a1408" }
  },

  "default": { "palette": "citrus", "theme": "light" }
}
